{
  "name": "playsight-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include server server/index.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch --clear-screen=false --include server server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "playwright:install": "playwright install chromium",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "latest",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.13.1",
    "playwright": "^1.55.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "swr": "^2.3.6",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
