# PlaySight Core Environment Configuration

PORT=3000
APP_BASE_URL="http://localhost:3000"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgres://username:password@localhost:5432/playsight_core"

# GitHub App Integration
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_NAME="playsight-core"

# Jira Cloud OAuth Integration
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_REDIRECT_URI="http://localhost:3000/api/integrations/jira/callback"

# Playwright Test Execution
PLAYWRIGHT_HEADLESS=true
EXECUTOR_CONCURRENCY=2
ARTIFACTS_DIR="artifacts"
